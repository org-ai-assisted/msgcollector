#systemctl --user start msgcollector-gui.service
#systemctl --user status msgcollector-gui.service
#journalctl --user -f -u msgcollector-gui.service

[Unit]
Description=msgcollector msgdispatcher

[Service]
Type=notify
ExecStart=/usr/libexec/msgcollector/msgdispatcher
KillMode=control-group
KillSignal=SIGKILL
NotifyAccess=all
WatchdogSec=30
Restart=always

## W^X hardening (anonymous + file-backed). MemoryDenyWriteExecute denies anon
## W+X and mprotect/shmat gaining PROT_EXEC; SystemCallArchitectures=native closes
## the secondary-ABI (i386) bypass; LockPersonality blocks READ_IMPLIES_EXEC;
## SystemCallFilter=~memfd_create kills the memfd bypass; NoExecPaths marks the
## shared writable dirs non-executable (file-backed exec). msgdispatcher is bash;
## its Qt dialog helpers are widget GUIs (no QtWebEngine/QML), no JIT.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LockPersonality=true
SystemCallFilter=~memfd_create
NoExecPaths=/tmp /var/tmp /dev/shm

## Defense-in-depth (separate axis from W^X): NoNewPrivileges blocks this
## daemon and its children from gaining privileges (setuid/setgid, file
## capabilities, AppArmor non-subset Px). No child gains privilege.
NoNewPrivileges=yes

[Install]
